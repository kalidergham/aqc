# انسخ هذا الملف إلى .env ثم املأ القيم الحقيقية
# cp .env.example .env

# توكن بوت تليجرام (من @BotFather)
BOT_TOKEN=123456:ABC-ضع_التوكن_هنا

# مفتاح ElevenLabs API (من لوحة التحكم في موقع elevenlabs.io)
ELEVENLABS_API_KEY=ضع_مفتاح_elevenlabs_هنا

# النموذج المستخدم للتوليد (متعدد اللغات لدعم العربية)
ELEVENLABS_MODEL=eleven_multilingual_v2

# الحد الأدنى لمدة المقطع الصوتي بالثواني
MIN_VOICE_DURATION=30

# الحد الأقصى لطول النص المسموح بتحويله
MAX_TEXT_LENGTH=2500

# مجلد الملفات المؤقتة
TEMP_DIR=temp
